# Railway services use dashboard variables instead of this file.
# Backend: set DATABASE_URL, SESSION_SECRET, APP_BASE_URL,
# GOOGLE_OAUTH_CLIENT_ID, and GOOGLE_OAUTH_CLIENT_SECRET.
# Promotion cron: set DATABASE_URL and SESSION_SECRET.
# ENV defaults to production, so Railway can omit it.
# The POSTGRES_* values below are only for local docker-compose development.

ENV=development

POSTGRES_USER=shopping_list
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=shopping_list
POSTGRES_TEST_DB=shopping_list_test

DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_TEST_DB}

SESSION_SECRET=
APP_BASE_URL=http://localhost:8080

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
