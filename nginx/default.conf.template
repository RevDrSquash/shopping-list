map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen ${PORT};

  # Re-resolve upstream hostnames at runtime so we don't get stuck on stale IPs
  # after Railway reschedules the backend or frontend container. NGINX_LOCAL_RESOLVERS
  # is exported by the upstream nginx image's 15-local-resolvers.envsh entrypoint
  # script, which reads /etc/resolv.conf and bracket-wraps IPv6 addresses.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;

  proxy_http_version 1.1;
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 1h;
  proxy_send_timeout 1h;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  location /api/ {
    set $backend_upstream "http://${BACKEND_HOST}";
    rewrite ^/api/(.*) /$1 break;
    proxy_pass $backend_upstream$uri$is_args$args;
  }

  location / {
    set $frontend_upstream "http://${FRONTEND_HOST}";
    proxy_pass $frontend_upstream$request_uri;
  }
}
